# Ignore virtual environment
venv/
env/
.venv/

# Ignore Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Ignore environment files with secrets
.env

# Ignore IDE settings
.vscode/
.idea/
*.swp
*.swo

# Ignore model files (large)
*.keras
*.h5
*.pkl
models/saved/
models/scalers/

# Ignore data cache
data/cache/
data/*.csv
data/*.json

# Ignore logs
*.log
logs/

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore coverage reports
htmlcov/
.coverage
.pytest_cache/

# Ignore build artifacts
dist/
build/
*.egg-info/
