# =============================================================================
# ENVIRONMENT CONFIGURATION
# Marine Safety Forecasting System
# =============================================================================

# Flask Configuration
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================
# Get these values from Azure Portal > Azure OpenAI resource

# Your Azure OpenAI endpoint URL
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API Key
# Found in Azure Portal > Keys and Endpoint
AZURE_OPENAI_API_KEY=

# Your GPT-4o deployment name
# This is the name you gave when deploying the model
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# API Version (usually keep default)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file with actual API keys to version control
# 2. Create a .env file (copy from .env.example) and add your keys
# 3. The system works without Azure OpenAI (uses fallback explanations)
# 4. NASA POWER and Open-Meteo APIs are FREE and need no keys
