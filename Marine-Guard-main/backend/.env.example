FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000


CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =============================================================================
# GROQ AI CONFIGURATION
# =============================================================================
# Get these values from Groq Console (https://console.groq.com)

# Your Groq API Key
GROQ_API_KEY=your_api_key_here

# Your Groq Model (default is llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant


LOG_LEVEL=INFO
